        "result": {
          "action_type": "read_file",
          "success": true,
          "output": "from __future__ import annotations\nfrom typing import Optional\n\nfrom .documents import normalize\nfrom .store import existing\n\ndef query(database, text: str, limit: Optional[int] = None) -> dict:\n    if not text.strip():\n        raise ValueError('query must be nonempty')\n    if limit is not None:\n        if isinstance(limit, bool) or not isinstance(limit, int) or limit <= 0:\n            raise ValueError('limit must be a positive integer')\n    with existing(database) as connection:\n        rows = connection.execute('SELECT path FROM documents WHERE instr(search,?) > 0 ORDER BY path', (normalize(text),)).fetchmany(limit if limit is not None else -1)\n    matches = [{'path': row[0]} for row in rows]\n    return {'count': len(matches), 'matches': matches}\n",
          "exit_code": null,
