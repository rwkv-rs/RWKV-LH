              "exact_spans": [
                {
                  "span_id": "OBS-SPAN-474ab8e7826e8aa17a20",
                  "source_ref": "index_cli.py",
                  "snapshot_sha256": "351b10f81d5bcb1d05203bb1c3c50170e3622f4bd5841d781e70110cf757b3c8",
                  "start_byte": 0,
