                {
                  "span_id": "OBS-SPAN-8c18b261484a5b6f8575",
                  "source_ref": "test_query_limit.py",
                  "snapshot_sha256": "3d08f872136753c27a00cb226120cc081247b00282252897d675861c0136d2d3",
                  "start_byte": 0,
