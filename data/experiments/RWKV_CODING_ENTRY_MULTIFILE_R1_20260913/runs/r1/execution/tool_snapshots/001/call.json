{
  "action_type": "search_text",
  "arguments": {
    "case_sensitive": true,
    "max_file_bytes": 100000000,
    "max_line_chars": 4000,
    "max_results": 10,
    "max_tokens": 4096,
    "mode": "regex",
    "path": ".",
    "pattern": "query\\s*\\(.*,?\\s*limit\\s*=\\s*(?:\\d+)?\\)",
    "recursive": true,
    "start_after": ""
  }
}
