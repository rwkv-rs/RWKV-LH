                {
                  "span_id": "OBS-SPAN-292c729543bfd69e9451",
                  "source_ref": "state_tokens.py",
                  "snapshot_sha256": "6c496d3061abd6d764881b71f1b2c06f4bb85b44a3c6763e2807b313b17da882",
                  "start_byte": 0,
