                )),
                json.dumps({"function": "final_answer", "params": {"text": "Updated."}}),
                json.dumps(_audit_call(
                    "ready_for_final", step_id="", step_complete=False,
                    evidence_refs=["A00001", "A00002"], gaps=[], reason="verified update",
