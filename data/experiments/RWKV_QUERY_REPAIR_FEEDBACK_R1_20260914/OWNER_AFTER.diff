+def test_each_online_microtask_gets_a_fresh_actor_state_with_reviewed_facts(
+    tmp_path: Path,
+) -> None:
+    supervisor = OnlineFakeSupervisor(
+        [
+            {
+                "disposition": "continue",
+                "review_status": "initial",
+                "review_summary": "Start with a bounded inspection.",
+                "microtask_objective": "FIRST-DIRECTIVE-ONLY inspect missing.txt.",
+                "completion_checks": ("The failed reads are observed.",),
+            },
+            {
+                "disposition": "continue",
+                "review_status": "needs_correction",
+                "review_summary": "The repeated reads made no progress.",
+                "issues": ("Use a workspace mutation instead of repeating the read.",),
+                "microtask_objective": "SECOND-DIRECTIVE-ONLY create hello.txt.",
+                "completion_checks": ("hello.txt contains hello.",),
+            },
+            {
+                "disposition": "accept_final",
+                "review_status": "satisfied",
+                "review_summary": "The corrective write supports the Final.",
+            },
+        ]
+    )
+    controller, _, workspace, client = build(
+        tmp_path,
+        [
+            call("read_file", path="missing.txt"),
+            call("read_file", path="missing.txt"),
+            call("write_file", path="hello.txt", content="hello"),
+            call("final_answer", text="Created hello.txt."),
+        ],
+        supervisor,
+        policy=SupervisorPolicy(
+            mode="online_microtask",
+            max_online_directives=8,
+            online_actions_per_directive=6,
+        ),
+    )
+
+    result = controller.run("RUN")
+
+    assert result.state.status == RunStatus.COMPLETED
+    assert (workspace / "hello.txt").read_text(encoding="utf-8") == "hello"
+    roots = [
+        checkpoint
+        for checkpoint in result.state.model_states.values()
+        if checkpoint.lane_kind.value == "action"
+        and checkpoint.parent_checkpoint_id is None
+    ]
+    assert len(roots) == 2
+    starts = [
+        event
+        for event in result.state.causal_records.values()
+        if event.event_type == "action_session_started"
+        and event.payload.get("session_scope") == "one_supervisor_microtask"
+    ]
+    assert len(starts) == 2
+    assert all(event.payload["actor_state_inherited"] is False for event in starts)
+    second_state_prompt = client.prompts[2]
+    assert "SECOND-DIRECTIVE-ONLY" in second_state_prompt
+    assert "FIRST-DIRECTIVE-ONLY" not in second_state_prompt
+    assert '"first": 1' in second_state_prompt
+    assert '"last": 2' in second_state_prompt
+    assert '"count": 2' in second_state_prompt
+    assert '"success": false' in second_state_prompt
+
+
