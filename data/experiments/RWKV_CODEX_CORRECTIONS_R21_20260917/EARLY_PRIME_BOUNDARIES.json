    "output": "{\n  \"function\": \"write_file\",\n  \"params\": {\n    \"content\": \"import sys\\n\\ndef is_prime(n):\\n    if n < 2:\\n        return False\\n    if n == 2:\\n        return True\\n    if n % 2 == 0:\\n        return False\\n    limit = int(n ** 0.5) + 1\\n    for i in range(3, limit, 2):\\n        if n % i == 0:\\n            return False\\n    return True\\n\\ndef main():\\n    data = sys.stdin.read().strip()\\n    if not data:\\n        print(0)\\n        return\\n    try:\\n        n = int(data)\\n    except ValueError:\\n        print(0)\\n        return\\n    if n < 2:\\n        print(0)\\n        return\\n    count = 0\\n    for i in range(2, n + 1):\\n        if is_prime(i):\\n            count += 1\\n    print(count)\\n\\nif __name__ == \\\"__main__\\\":\\n    main()\\n\",\n    \"path\": \"solution.py\"\n  }\n}"
