        if supervisor_first:
            planner = SupervisorAPISettings.from_env()
            runtime = RuntimeSettings.from_env()
        else:
            runtime = RuntimeSettings.from_env()
            planner = SupervisorAPISettings.from_env()
        policy = supervisor_module.supervisor_policy_from_env()
    
