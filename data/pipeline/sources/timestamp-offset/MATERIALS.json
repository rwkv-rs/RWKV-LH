                {
                  "span_id": "OBS-SPAN-9bf8d62aef4d59a40bca",
                  "source_ref": "test_timestamp_offset.py",
                  "snapshot_sha256": "50c635791a962ec61a48ec763cae35553583e47bc7fe781d171fe6210e9a47cd",
