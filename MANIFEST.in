include README.md LICENSE pyproject.toml uv.lock
prune docs
include docs/ARCHITECTURE.zh-CN.md
exclude AGENTS.md
graft rwkv_lh
graft scripts
prune data
prune tests
prune benchmarks
prune acceptance_tests
prune temp
prune outputs
exclude scripts/freeze_project_benchmark.py
exclude scripts/generate_agent_capability_ladder_v1.py
exclude scripts/generate_agent_v1_project_suite.py
exclude scripts/prepare_project_natural_dev.py
exclude scripts/run_calendar_project_trial.py
exclude scripts/run_rwkv_e2e_benchmark.py
exclude scripts/test_calendar_project.py
exclude scripts/test_project_basics.py
exclude scripts/test_project_expense_tracker.py
global-exclude *.py[cod] *.log *.pt *.pth *.safetensors *.db *.sqlite *.sqlite3
global-exclude .env .env.local
