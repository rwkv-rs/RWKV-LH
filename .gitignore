# Public repository: architecture, maintained project sources and build metadata.
# Tests, benchmarks, experiments and generated files remain local.
/*
!/.env.example
!/.gitattributes
!/.github/
!/.gitignore
!/AGENTS.md
!/LICENSE
!/MANIFEST.in
!/README.md
!/docs/
!/pyproject.toml
!/rwkv_lh/
!/scripts/
!/uv.lock

# Local evaluation entrypoints; retained for the private regression environment.
/scripts/freeze_project_benchmark.py
/scripts/generate_agent_capability_ladder_v1.py
/scripts/generate_agent_v1_project_suite.py
/scripts/prepare_project_natural_dev.py
/scripts/run_calendar_project_trial.py
/scripts/run_rwkv_e2e_benchmark.py
/scripts/test_calendar_project.py
/scripts/test_project_basics.py
/scripts/test_project_expense_tracker.py

# Secrets, caches and build outputs are never project source.
.env
.env.*
!.env.example
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.log
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.pt
*.pth
*.safetensors
*.tmp
.DS_Store
Thumbs.db
