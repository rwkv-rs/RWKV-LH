# OpenAI-compatible RWKV endpoint. Copy this file to .env.local.
RWKV_BASE_URL=http://127.0.0.1:29613/v1
RWKV_API_KEY=
RWKV_MODEL=rwkv7-g1i-13.3b-20260805-ctx16384

# HTTP behavior
RWKV_CONNECT_TIMEOUT=10
RWKV_READ_TIMEOUT=300
RWKV_RETRY_ATTEMPTS=2
RWKV_RETRY_BACKOFF=0.5
RWKV_TRUST_ENV=false
RWKV_VERIFY_TLS=true

# Used only when a model call is made outside the Agent's request-level policy.
RWKV_DEFAULT_TEMPERATURE=0.1
