# RWKV endpoint. Copy this file to .env.local and select its real wire profile.
RWKV_BASE_URL=http://127.0.0.1:29613/v1
RWKV_API_KEY=
RWKV_MODEL=rwkv7-g1i-13.3b-20260805-ctx16384
RWKV_BACKEND_PROFILE=vllm-rwkv-rapid

# Optional Cloudflare Access and explicit proxy for a remote RWKV endpoint.
# Keep credentials only in ignored .env.local or process environment.
RWKV_CF_ACCESS_CLIENT_ID=
RWKV_CF_ACCESS_CLIENT_SECRET=
RWKV_PROXY_URL=

# HTTP behavior
RWKV_CONNECT_TIMEOUT=10
RWKV_READ_TIMEOUT=300
RWKV_RETRY_ATTEMPTS=2
RWKV_RETRY_BACKOFF=0.5
RWKV_TRUST_ENV=false
RWKV_VERIFY_TLS=true

# Used only when a model call is made outside the Agent's request-level policy.
RWKV_DEFAULT_TEMPERATURE=0.1
RWKV_DEFAULT_TOP_P=1.0
RWKV_DEFAULT_TOP_K=0
RWKV_DEFAULT_PRESENCE_PENALTY=0.0
RWKV_DEFAULT_FREQUENCY_PENALTY=0.0
RWKV_DEFAULT_PENALTY_DECAY=0.996

# Must match the deployed RWKV endpoint context configuration.
RWKV_MAX_MODEL_LEN=16384
RWKV_CONTEXT_SAFETY_MARGIN=32
RWKV_BOS_TOKEN_COUNT=1

# Optional response metadata for debugging. Keep false for normal runs.
RWKV_RETURN_TOKEN_IDS=false
