        {"kind": "json_equals", "path": "selected.json", "value": {"payload": {"region": "apac", "revision": 9, "flags": ["safe", "stable"]}, "selected_source": "data/backup.json"}},
        {"kind": "event_min_count", "event_type": "action_returned", "count": 2}
      ]
    },
    "E2E-H10": {
      "checks": [
        {"kind": "command_exit", "argv": ["python3", "verify_release.py"], "exit_code": 0},
        {"kind": "json_equals", "path": "release/inventory.json", "value": {"items": [{"sku": "A1", "total": 18.0}, {"sku": "B2", "total": 18.0}, {"sku": "C3", "total": 4.5}], "grand_total": 40.5}},
        {"kind": "file_contains", "path": "release/REPORT.md", "text": "Grand total: 40.5"}
      ]
