{
  "schema_version": "rwkv-e2e-30.acceptance.v1",
  "cases": {
    "E2E-B01": {
      "checks": [
        {"kind": "file_content", "path": "greeting.txt", "content": "Hello, RWKV-LH!\n"}
      ]
    },
    "E2E-B02": {
      "checks": [
        {"kind": "json_equals", "path": "report.json", "value": {"project": "Orion", "doubled_count": 14}},
        {"kind": "json_exact_keys", "path": "report.json", "keys": ["project", "doubled_count"]}
      ]
    },
    "E2E-B03": {
      "checks": [
        {"kind": "json_equals", "path": "config.json", "value": {"name": "alpha", "feature": {"enabled": true, "mode": "safe"}, "retries": 4}}
      ]
    },
    "E2E-B04": {
      "checks": [
        {"kind": "files_equal", "left": "source.txt", "right": "archive/2026/source.txt"},
        {"kind": "file_content", "path": "archive/manifest.txt", "content": "archive/2026/source.txt\n"}
      ]
    },
    "E2E-B05": {
      "checks": [
        {"kind": "file_content", "path": "app.env", "content": "name=demo\nport=8080\nmode=prod\n"},
        {"kind": "file_not_contains", "path": "app.env", "text": "deprecated=true"}
      ]
    },
    "E2E-B06": {
      "checks": [
        {"kind": "file_content", "path": "combined.txt", "content": "alpha\nbeta\n---\ngamma\ndelta\n"}
      ]
    },
    "E2E-B07": {
      "checks": [
        {"kind": "file_content", "path": "endpoint.txt", "content": "https://api.example.com\n"},
        {"kind": "path_absent", "path": "staging_endpoint.txt"}
      ]
    },
    "E2E-B08": {
      "checks": [
        {"kind": "json_exact_keys", "path": "manifest.json", "keys": ["file", "sha256"]},
        {"kind": "sha256_manifest", "source": "payload.txt", "manifest": "manifest.json", "file_field": "file", "digest_field": "sha256"}
      ]
    },
    "E2E-B09": {
      "checks": [
        {"kind": "json_equals", "path": "stats.json", "value": {"row_count": 3, "total_score": 45, "average_score": 15}}
